<?xml version="1.0" encoding="UTF-8"?>
<Wix xmlns="http://schemas.microsoft.com/wix/2006/wi">
	<Product Id="*" Name="ConsoleApp Setup 1.3" Language="1033" Version="1.0.0.0" Manufacturer="SwinburneStudent"
	UpgradeCode="{8B26AD0D-9DCB-4BAC-BA9A-A48F919B8646}">
		<Package InstallerVersion="200" Compressed="yes" InstallScope="perMachine" />
		<MediaTemplate EmbedCab="yes" />
		<Directory Id="TARGETDIR" Name="SourceDir">
			<Directory Id="ProgramFilesFolder">
				<Directory Id="INSTALLFOLDER" Name="ConsoleApp_1.3" />
			</Directory>
		</Directory>
		<DirectoryRef Id="INSTALLFOLDER">
			<Component Id="MainExecutable" Guid="{04E6F8A3-1FA0-4BB3-A0F1-66A955447268}">
				<File Id="ConsoleApp1.3EXE" Source="$(var.ConsoleApp_1.3.TargetPath)" KeyPath="yes" />
			</Component>
			<Component Id="DLL1" Guid="{1732B725-3A38-4F90-8DBC-E3634FEE427C}">
				<File Id="DLL_1.1.3DLL" Source="$(var.DLL_1.1.3.TargetPath)" KeyPath="yes" />
			</Component>
			<Component Id="DLL2" Guid="{255D0071-1611-46F2-9EC1-B2C32FF55151}">
				<File Id="DLL_2.1.3DLL" Source="$(var.DLL_2.1.3.TargetPath)" KeyPath="yes" />
			</Component>
		</DirectoryRef>
		<Feature Id="ProductFeature" Title="SampleAppSetup" Level="1">
			<ComponentRef Id="MainExecutable" />
			<ComponentRef Id="DLL1" />
			<ComponentRef Id="DLL2" />
		</Feature>
	</Product>
</Wix>
